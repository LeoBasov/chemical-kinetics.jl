seed 123456 #73242
dimension   	    3
global              gridcut 1.0e-5 comm/sort yes

boundary	    r r r

create_box  	    0 0.0001 0 0.0001 0 0.0001
Created orthogonal box = (0 0 0) to (0.0001 0.0001 0.0001)
create_grid 	    1 1 1
Created 1 child grid cells
  CPU time = 0.00384712 secs
  create/ghost percent = 98.7234 1.27665

balance_grid        rcb part
Balance grid migrated 0 cells
  CPU time = 8.39233e-05 secs
  reassign/sort/migrate/ghost percent = 32.1023 0 53.6932 14.2045

species		    ../species_data/air.species O O2

mixture         O2 O2 temp 10000.0 nrho 0.1E23
mixture         O O temp 10000.0 nrho 0.9E23

global              fnum 1E7

hybrid set_fp
lmixfokkerplanck basic all
lmixfokkerplanck_modify ../species_data/air.vss ave 2e12 3e12 0.01 VHS yes rotate clt vibrate dlt  moment_int complex thermo_diffusion yes linear_model no relax variable

collide		    vss all ../species_data/air.vss relax variable
collide_modify rotate smooth vibrate discrete
react fp recombination.tce

create_particles    O2 n 0 twopass
Created 1000 particles
  CPU time = 0.00343013 secs
create_particles    O n 0 twopass
Created 9000 particles
  CPU time = 0.00231004 secs

compute temp thermal/grid all all temp
compute trot grid all all trot

compute tvib_O2 tvib/grid all O2

compute red_temp reduce ave c_temp[*]
compute red_trot reduce ave c_trot[*]

compute red_tvib_O2 reduce ave c_tvib_O2[*]

compute	nrho_O2 grid all O2 nrho
compute	nrho_O grid all O nrho

compute red_nrho_O2 reduce ave c_nrho_O2[*]
compute red_nrho_O reduce ave c_nrho_O[*]

compute	n_O2 grid all O2 n
compute	n_O grid all O n

compute red_n_O2 reduce ave c_n_O2[*]
compute red_n_O reduce ave c_n_O[*]

compute ke grid all species ke
compute erot grid all species erot
compute evib grid all species evib

compute red_ke reduce ave c_ke[*]
compute red_erot reduce ave c_erot[*]
compute red_evib reduce ave c_evib[*]

