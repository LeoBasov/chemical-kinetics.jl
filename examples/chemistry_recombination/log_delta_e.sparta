seed 123456 #73242
dimension   	    3
global              gridcut 1.0e-5 comm/sort yes

boundary	    r r r

create_box  	    0 0.0001 0 0.0001 0 0.0001
Created orthogonal box = (0 0 0) to (0.0001 0.0001 0.0001)
create_grid 	    1 1 1
Created 1 child grid cells
  CPU time = 0.0031178 secs
  create/ghost percent = 99.2047 0.795289

balance_grid        rcb part
Balance grid migrated 0 cells
  CPU time = 4.3869e-05 secs
  reassign/sort/migrate/ghost percent = 29.3478 0 61.413 9.23913

species		    ../species_data/air.species O O2

mixture         O2 O2 temp 10000.0 nrho 0.1E23
mixture         O O temp 10000.0 nrho 0.9E23

global              fnum 1E7

hybrid set_fp
lmixfokkerplanck basic all
lmixfokkerplanck_modify ../species_data/air.vss ave 2e12 3e12 0.01 VHS yes rotate clt vibrate dlt  moment_int complex thermo_diffusion yes linear_model no relax variable

collide		    vss all ../species_data/air.vss relax variable
collide_modify rotate smooth vibrate discrete
react fp recombination.tce

create_particles    O2 n 0 twopass
Created 1000 particles
