compute red_nrho_O reduce ave c_nrho_O[*]

compute	n_O2 grid all O2 n
compute	n_O grid all O n

compute red_n_O2 reduce ave c_n_O2[*]
compute red_n_O reduce ave c_n_O[*]

compute ke grid all species ke
compute erot grid all species erot
compute evib grid all species evib

compute red_ke reduce ave c_ke[*]
compute red_erot reduce ave c_erot[*]
compute red_evib reduce ave c_evib[*]

